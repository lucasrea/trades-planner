# Copy to apps/mobile/.env.local. Expo builds these into the app, so never put a secret here.

# Base URL of the web app the phone talks to, no trailing slash. Required in every build; there is no default.
# On a real phone use your computer's LAN IP, and on the Android emulator http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# The web Google OAuth client ID (the web app's AUTH_GOOGLE_ID). Required to sign in.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# The iOS Google OAuth client ID. Required to sign in on iOS, at build time too.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Phone Sentry project DSN; unset means nothing is reported. Optional.
# EXPO_PUBLIC_SENTRY_DSN=
# "true" also reports native crashes, which bypass the on-device scrubbing (see PR 138). Leave unset.
# EXPO_PUBLIC_SENTRY_NATIVE_CRASHES=
