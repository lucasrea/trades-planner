AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase Postgres — Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URL on Vercel (port 6543, ?pgbouncer=true).
DATABASE_URL=

# Server-only — OpenAI (describe/receipt when AI_PROVIDER=live)
OPENAI_API_KEY=

# Server-only — Supabase Storage for receipt photos (private bucket "receipts", created by
# supabase/migrations/20261108100000_receipts_bucket.sql). Without these, production refuses receipt
# uploads; local dev falls back to an in-memory fake.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
