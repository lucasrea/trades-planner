# Copy to apps/web/.env.local and fill in. Never commit real values.
# Commented lines are optional: leave them commented to get the default. An empty value is not the same as unset.
# NODE_ENV, VERCEL_ENV and CI are also read, but Next.js, Vercel and the CI runner set them; do not set them here.

# ---- Sign-in ----

# Signs and encrypts NextAuth session tokens. Required in production.
AUTH_SECRET=generate-a-long-random-string
# Public base URL of the web app, used by sign-in and for links in document emails. Required in production.
AUTH_URL=http://localhost:3000
# Google OAuth web client ID; also the audience checked on phone sign-in tokens. Required in production.
AUTH_GOOGLE_ID=
# Google OAuth web client secret. Required in production.
AUTH_GOOGLE_SECRET=
# iOS bundle ID, the audience of phone Sign in with Apple tokens; unset refuses Apple sign-in. Required for Apple sign-in.
# AUTH_APPLE_BUNDLE_ID=com.tradesplanner.app
# Optional, comma separated: more of this app's Google client IDs to accept as a phone token's audience.
# AUTH_GOOGLE_MOBILE_AUDIENCES=

# ---- Database ----

# Supabase Postgres connection string (Project Settings → Database); on Vercel use the "Transaction" pooler (port 6543, ?pgbouncer=true). Required in production.
DATABASE_URL=
# Throwaway local database for integration tests and the Plan eval, which DROP its public schema. Set it in the shell (they do not read .env.local). Never set in production.
# DATABASE_URL_TEST=postgres://ci:ci@127.0.0.1:54329/ci

# Production AUTH_URL that scripts/sync-vercel-env.sh pushes to Vercel (it has a built-in default). That script only.
# AUTH_URL_PRODUCTION=https://your-app.example.com

# ---- AI ----

# "fake" or "live"; unset means fake outside production and live in production. Optional in production.
# AI_PROVIDER=fake
# Exactly "false" turns off web capture routes and phone text capture (they return 503). Optional in production.
# AI_CAPTURE_ENABLED=true
# Server-only OpenAI key. Required in production (whenever the provider is live).
OPENAI_API_KEY=
# Model for receipt reading, and for Plan unless PLAN_MODEL is set. Required in production (live).
EXTRACTION_MODEL=
# Model for the one retry after a rate limit or provider server error during extraction; defaults to EXTRACTION_MODEL. Optional in production.
# EXTRACTION_MODEL_FALLBACK=
# Model that turns voice recordings into text. Required in production (live).
TRANSCRIPTION_MODEL=
# Model for the Plan chat only; defaults to EXTRACTION_MODEL. Optional in production.
# PLAN_MODEL=
# Plan reasoning effort: "minimal", "low" or "medium"; unset uses the app's choice for the model. Optional in production.
# PLAN_REASONING_EFFORT=low
# Plan reply length: "low", "medium" or "high"; unset uses the model's default. Optional in production.
# PLAN_VERBOSITY=low
# Behaviour of the fake provider: "ok", "slow", "error", "malformed" or "empty". Development and tests only.
# AI_FAKE_MODE=ok
# Delay in milliseconds when AI_FAKE_MODE is "slow" (default 3000). Development and tests only.
# AI_FAKE_DELAY_MS=3000
# Output file for scripts/eval-plan-chats.ts (default plan-chats-eval.json). Eval script only; set it in the shell, not in .env.local.
# EVAL_OUT=plan-chats-eval.json

# ---- Email ----

# "fake" or "resend"; unset means email is off. Required in production only to send email.
# EMAIL_PROVIDER=fake
# Resend API key. Required in production when EMAIL_PROVIDER is "resend".
RESEND_API_KEY=
# Sender such as "Your Business <invoices@example.com>", on a domain verified in Resend. Required in production when EMAIL_PROVIDER is "resend".
EMAIL_FROM=

# ---- Receipt photos ----

# Supabase project URL for photo storage (private "receipts" bucket, see supabase/migrations); unset uses an in-memory fake in development. Required in production.
SUPABASE_URL=
# Server-only Supabase service role key for that bucket. Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Error tracking (Sentry) ----

# Web project DSN; unset means nothing is reported and no source maps are uploaded. Read at build time. Production only.
# NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during the build; runs only when the DSN and all three are set. Production only.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
