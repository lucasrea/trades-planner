{
  "name": "trades-planner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w trades-planner-web",
    "dev:mobile": "npm run start -w trades-planner-mobile",
    "build": "npm run build -w trades-planner-web",
    "start": "npm run start -w trades-planner-web",
    "lint": "npm run lint -w trades-planner-web",
    "test": "npm run test -w trades-planner-web",
    "typecheck": "npm run typecheck -w trades-planner-web && npm run typecheck -w trades-planner-mobile",
    "test:integration": "npm run test:integration -w trades-planner-web",
    "db:push": "npm run db:push -w trades-planner-web",
    "db:studio": "npm run db:studio -w trades-planner-web"
  }
}
